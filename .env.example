# 模型接入（OpenAI 兼容协议）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=deepseek-flash

# 生成参数
TEMPERATURE=0.3

# 上下文裁剪的 token 预算（不含 system prompt）
CHAT_TOKEN_BUDGET=800

# DeepSeek 思考模式与强制 tool_choice 冲突，结构化抽取需关闭思考
DISABLE_THINKING=true

# MySQL（WSL Docker，映射到 3307 避免与本机 3306 冲突）
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3307/customer_service?charset=utf8mb4

# 工具执行超时（秒）与重试次数
TOOL_TIMEOUT=5
TOOL_RETRIES=2
